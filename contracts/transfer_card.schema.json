{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TransferCard",
  "type": "object",
  "required": ["id", "fromBranch", "toBranch", "itemCode", "quantity", "priority", "status", "requestedAt"],
  "properties": {
    "id": {"type": "string"},
    "fromBranch": {"type": "string"},
    "toBranch": {"type": "string"},
    "itemCode": {"type": "string"},
    "quantity": {"type": "integer", "minimum": 1},
    "priority": {"type": "string", "enum": ["urgent", "high", "normal"]},
    "status": {"type": "string"},
    "requestedAt": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  },
  "additionalProperties": false
}
